<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aimrp</groupId>
        <artifactId>aimrp</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>aimrp-api</artifactId>
    <packaging>jar</packaging>

    <name>AI MRP API</name>
    <description>API 网关入口模块</description>

    <dependencies>
        <!-- 引入公共模块 -->
        <dependency>
            <groupId>com.aimrp</groupId>
            <artifactId>aimrp-common</artifactId>
            <version>${project.version}</version>
            <version>${project.version}</version>
        </dependency>
        
        <!-- 引入业务模块 -->
        <dependency>
            <groupId>com.aimrp</groupId>
            <artifactId>aimrp-demand</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.aimrp</groupId>
            <artifactId>aimrp-mrp</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.aimrp</groupId>
            <artifactId>aimrp-conversation</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
